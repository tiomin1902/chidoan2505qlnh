/** Christmas V23 public presentation config. No student data or schema migration. */
const QLNH_XMAS_KEY_='QLNH_CHRISTMAS_V23';
function qlnhChristmasDefaults_(){const p=m=>({snow:true,lights:true,santa:true,lodge:true,snowman:true,stockings:true,fire:true,tree:true,gifts:true,countdown:true,density:m?24:64,bulbs:m?13:32,duration:m?4:7});return {mode:'off',start:'2026-11-21T00:00',end:'2026-12-25T23:59',title:'Merry Christmas',wish:'Giáng sinh ấm áp — Gắn kết yêu thương.',revision:0,music:false,desktop:p(false),mobile:p(true)};}
function qlnhChristmasSafe_(x){if(!x||typeof x!=='object'||!['auto','on','off'].includes(x.mode))throw Error('Chế độ Noel không hợp lệ');let d=qlnhChristmasDefaults_(),o={mode:x.mode};for(const k of ['start','end']){if(typeof x[k]!=='string'||!/^\d{4}-\d\d-\d\dT\d\d:\d\d$/.test(x[k])||!Number.isFinite(Date.parse(x[k]+':00+07:00')))throw Error('Ngày giờ không hợp lệ');o[k]=x[k];}if(o.end<o.start)throw Error('Thời gian kết thúc phải sau thời gian bắt đầu');for(const k of ['title','wish']){if(typeof x[k]!=='string'||!x[k].trim()||x[k].length>180)throw Error('Lời chúc từ 1 đến 180 ký tự');o[k]=x[k].trim();}if(!Number.isSafeInteger(x.revision)||x.revision<0)throw Error('Phiên bản cấu hình không hợp lệ');o.revision=x.revision;o.music=x.music===true;for(const n of ['desktop','mobile']){const a=x[n];if(!a||typeof a!=='object')throw Error('Thiếu cấu hình thiết bị');o[n]={};for(const k of Object.keys(d[n])){if(typeof d[n][k]==='boolean'){if(typeof a[k]!=='boolean')throw Error('Hiệu ứng không hợp lệ');o[n][k]=a[k];}else{const max=k==='density'?(n==='mobile'?40:100):k==='bulbs'?(n==='mobile'?20:40):12,min=k==='duration'?3:0;if(!Number.isInteger(a[k])||a[k]<min||a[k]>max)throw Error('Thông số hiệu ứng vượt giới hạn');o[n][k]=a[k];}}}return o;}
function qlnhChristmasRead_(){const raw=PropertiesService.getScriptProperties().getProperty(QLNH_XMAS_KEY_);return raw?qlnhChristmasSafe_(JSON.parse(raw)):qlnhChristmasDefaults_();}
function qlnhChristmasPublic_(){return {success:true,...qlnhChristmasRead_()};}
function adminChristmasGet(token){auth_(token);return qlnhChristmasPublic_();}
function adminChristmasSave(token,payload){const actor=auth_(token),next=qlnhChristmasSafe_(payload),lock=LockService.getScriptLock();lock.waitLock(10000);try{const prev=qlnhChristmasRead_();if(next.revision!==prev.revision)throw Error('Cấu hình đã thay đổi, vui lòng tải lại trước khi lưu');next.revision=Math.max(Date.now(),prev.revision+1);PropertiesService.getScriptProperties().setProperty(QLNH_XMAS_KEY_,JSON.stringify(next));}finally{lock.releaseLock();}try{audit_(actor,'CHRISTMAS_THEME_SAVE',next.mode);}catch(_){}return {success:true,...next};}
